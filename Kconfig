# This Kconfig file is picked by the Zephyr build system because it is defined
# as the module Kconfig entry point (see zephyr/module.yml). You can browse
# module options by going to Zephyr -> Modules in Kconfig.

rsource "drivers/Kconfig"

config HPI_BACKUP_SIGNING_KEY
	string "Backup release key (PEM, absolute path)"
	default ""
	help
	  A second release key the device trusts alongside the primary
	  (keys/README.md, "Backup key"). Read by two images:

	  - MCUboot: when set, the bootloader's key table holds the primary
	    (CONFIG_BOOT_SIGNATURE_KEY_FILE) and this key, generated by this
	    module's CMakeLists.txt. Needs the MCUboot patch in
	    zephyr/patches.yml; without it the link fails, rather than the
	    bootloader silently trusting one key.
	  - The M7 application: its M4 and ESP32-C6 verifier accepts either key
	    (services/fw_release_sig.c).

	  A private key or a .pub.pem; only the public half is embedded.
	  Absolute path: Kconfig paths resolve against the west topdir, not this
	  repo. scripts/build.sh signed sets it on both images from
	  HP6_BACKUP_KEY.
