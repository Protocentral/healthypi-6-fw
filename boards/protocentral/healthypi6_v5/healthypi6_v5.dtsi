#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/clock/stm32h7_clock.h>

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/*
 * USART2 - HealthyLink Expansion UART with Hardware Flow Control
 * This is the primary serial interface for HealthyLink modules.
 * RTS/CTS enables reliable high-speed communication with module MCUs.
 */
&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6 &usart2_rts_pd4 &usart2_cts_pd3>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&mailbox {
	status = "okay";
};

&rcc {
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

/*
 * HealthyLink expansion port (two DF9 slots).
 *
 *   SPI4    PE2 SCK, PE5 MISO, PE6 MOSI; CS_A PE4, CS_B PE3 (plain GPIO)
 *   SPI6    PG13 SCK, PG12 MISO, PG14 MOSI; no CS assigned
 *   USART2  PD5 TX, PD6 RX, PD4 RTS, PD3 CTS
 *   UART4   PA0 TX, PI9 RX, PA15 RTS, PB0 CTS   - ESP32-C6 HealthyBridge
 *   FDCAN1  PH13 TX, PH14 RX
 *   I2C3    PH7 SCL, PH8 SDA                    - slot ID EEPROMs
 *   ADC     PA1, PA2, PA3, PC0, PC1, PC4        - in the M7 DTS
 *
 *   Slot A  EN_MOD PI1,  FLT PH11, RESET PI2, EEPROM 0x50
 *   Slot B  EN_MOD PH15, FLT PI4,  RESET PI5, EEPROM 0x51
 *   Shared  PWDN PI6, DRDY PH6, aux PI12-PI14
 *   Other   PA11 ESP32-C6 reset; PI3 user button (active low, external pull-up)
 *
 * No START, detect or StackLink GPIO: the ADS1299 is started with SPI opcodes,
 * modules are identified by their ID EEPROM, and StackLink is module-to-module.
 */

&i2c3 {
	status = "okay";
	pinctrl-0 = <&i2c3_scl_ph7 &i2c3_sda_ph8>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	/* Slot ID EEPROMs (AT24CS02) on the always-on rail. A0 is strapped per
	 * slot: GND on A (0x50), 3V3 on B (0x51). HealthyLink reads them over raw
	 * I2C; CONFIG_EEPROM is off. */
	healthylink_eeprom_a: eeprom@50 {
		compatible = "atmel,at24cs02", "atmel,at24";
		reg = <0x50>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;  /* tWR = 5 ms */
		status = "okay";
	};

	healthylink_eeprom_b: eeprom@51 {
		compatible = "atmel,at24cs02", "atmel,at24";
		reg = <0x51>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;  /* tWR = 5 ms */
		status = "okay";
	};
};

/* Module type written to a blank ID EEPROM by HealthyLink auto-provisioning,
 * which is OFF (CONFIG_HEALTHYLINK_AUTO_PROVISION=n in app_m7/prj.conf): this
 * node is inert, and is kept only for a production line that turns
 * auto-provisioning on for one module type per station. Modules are otherwise
 * programmed deliberately with `healthypi hl eeprom program`. Note it is
 * board-wide, NOT per slot -- whatever it names is what a blank EEPROM becomes
 * in either slot. */
/ {
	healthylink_default_compute: healthylink-compute-default {
		compatible = "protocentral,healthylink-compute";
		status = "okay";
	};

	chosen {
		healthylink-module = &healthylink_default_compute;
	};
};

/* SPI4 -- HealthyLink primary bus, shared by both slots. */
&spi4 {
	status = "okay";
	/* Kernel clock stays at the reset default (PLL1_Q): an explicit PLL2_Q
	 * override wedged spi_transceive at driver setup. */
	pinctrl-0 = <&spi4_sck_pe2 &spi4_miso_pe5 &spi4_mosi_pe6>;
	pinctrl-names = "default";
	/* st,soft-nss, not cs-gpios: cs-gpios wedges the first transceive on this
	 * board. SPI4 users drive CS_A (PE4) / CS_B (PE3) as plain GPIOs. */
	st,soft-nss;

	/* ADS1299 EEG front end, one node per slot (they differ only in reset),
	 * brought up by mod_eeg.c when a slot EEPROM reports an EEG module. */
	ads1299: ads1299@0 {
		compatible = "ti,ads1299";
		reg = <0>;
		spi-max-frequency = <4000000>;
		drdy-gpios = <&gpioh 6 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpioi 2 GPIO_ACTIVE_HIGH>;  /* MOD_RESET_A */
		pwdn-gpios = <&gpioi 6 GPIO_ACTIVE_HIGH>;
		gain = <24>;
		sample-rate = <250>;
		bias-enabled;
		srb1-enabled;
		status = "okay";
		zephyr,deferred-init;
	};

	ads1299_b: ads1299@1 {
		compatible = "ti,ads1299";
		reg = <1>;
		spi-max-frequency = <4000000>;
		drdy-gpios = <&gpioh 6 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpioi 5 GPIO_ACTIVE_HIGH>;  /* MOD_RESET_B */
		pwdn-gpios = <&gpioi 6 GPIO_ACTIVE_HIGH>;
		gain = <24>;
		sample-rate = <250>;
		bias-enabled;
		srb1-enabled;
		status = "okay";
		zephyr,deferred-init;
	};
};

/* SPI6 -- HealthyLink secondary bus. No cs-gpios: PA15 (SPI6 NSS on v3/v4) is
 * UART4 RTS on v5, so a SPI6 user brings its own CS. */
&spi6 {
	status = "okay";
	pinctrl-0 = <&spi6_sck_pg13 &spi6_miso_pg12 &spi6_mosi_pg14>;
	pinctrl-names = "default";
};

/* FDCAN1 -- for HealthyLink CAN modules. */
&fdcan1 {
	status = "okay";
	pinctrl-0 = <&fdcan1_tx_ph13 &fdcan1_rx_ph14>;
	pinctrl-names = "default";
	sample-point = <875>;
	sample-point-data = <875>;
};

/* USB OTG FS -- disabled: PA11 is the ESP32-C6 reset line. A USB-host module
 * overlay may enable it, and must supply 5 V VBUS with overcurrent protection. */
&usbotg_fs {
	status = "disabled";
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
};

/ {
	/* Port description only: no binding or driver uses this node. */
	healthylink: healthylink {
		compatible = "protocentral,healthylink";
		status = "okay";
		control-gpios = <&gpioi 2 GPIO_ACTIVE_HIGH>,   /* MOD_RESET_A */
		                <&gpioi 5 GPIO_ACTIVE_HIGH>,   /* MOD_RESET_B */
		                <&gpioi 6 GPIO_ACTIVE_HIGH>,   /* PWDN, shared */
		                <&gpioh 6 GPIO_ACTIVE_LOW>;    /* DRDY, shared */
		aux-gpios = <&gpioi 12 GPIO_ACTIVE_HIGH>,
		            <&gpioi 13 GPIO_ACTIVE_HIGH>,
		            <&gpioi 14 GPIO_ACTIVE_HIGH>;
	};

	/* Module slots: load switch, fault input and ID EEPROM. Driven by
	 * drivers/misc/healthylink/healthylink_core.c, one device per slot. */
	healthylink_slot_a: healthylink-slot-a {
		compatible = "protocentral,healthylink-slot";
		status = "okay";
		slot-label = "A";
		power-gpios = <&gpioi 1 GPIO_ACTIVE_HIGH>;                  /* EN_MOD_A */
		fault-gpios = <&gpioh 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* MOD_A_FLT */
		eeprom = <&healthylink_eeprom_a>;
	};

	healthylink_slot_b: healthylink-slot-b {
		compatible = "protocentral,healthylink-slot";
		status = "okay";
		slot-label = "B";
		power-gpios = <&gpioh 15 GPIO_ACTIVE_HIGH>;                /* EN_MOD_B */
		fault-gpios = <&gpioi 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* MOD_B_FLT */
		eeprom = <&healthylink_eeprom_b>;
	};
};
