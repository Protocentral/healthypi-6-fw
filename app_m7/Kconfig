	default "HealthyPi 6"

config HPI_CONNECTIVITY
	bool "ESP32-C6 connectivity (WiFi/BLE) via HealthyBridge SPI"
	default n
	help
	  Stream the sample bus to the ESP32-C6 network co-processor over the
	  HealthyBridge SPI link (SPI2, M7 master) for WiFi TCP + BLE GATT
	  re-streaming, and proxy WiFi control via the group-64 wifi_* commands
	  (0x0070-0x0073). A from-scratch L4 bus-consumer service
	  (services/connectivity/) on top of the existing
	  drivers/misc/healthybridge_esp32 driver + the ESP32-C6 app.

	  Default n: needs the ESP32-C6 firmware running and the SPI2 link
	  validated on hardware. When off, nothing touches SPI2 or the ESP32 and
	  the wifi_* commands return ENOTSUP.

config HPI_CONN_DEBUG
	bool "Log connectivity SPI link stats every 5 s"
	depends on HPI_CONNECTIVITY
	default n
	help
	  Phase-1 bring-up aid. The connectivity thread prints a 5-second window
	  of frames forwarded to the ESP32 per channel and the SPI send-failure
	  (drop) count: "conn 5s: ECG=.. PPG=.. vitals=.. sent | drops=..".
	  Rising sent counts with drops near zero means the SPI2 link to the
	  ESP32 is healthy; zero sent / high drops means the ESP32 is not
	  responding. Off in prod.

config HPI_WIRELESS_OTA
	bool "MCUmgr SMP transport on UART4 (ESP32 wireless OTA gateway)"
	depends on MCUMGR_TRANSPORT_UART
	# UART4 is the HealthyBridge host link. Two consumers on
	# one UART is not a degraded mode: both would call uart_callback_set() and
	# uart_rx_enable(), the second silently displacing the first, and the
	# symptom would be a link that stops carrying data for no visible reason.
	# Make the combination unselectable rather than merely discouraged. The
	# real answer is to carry SMP as a HealthyBridge frame type over the same
	# link -- migration plan P6.
	depends on !DT_HAS_PROTOCENTRAL_HEALTHYBRIDGE_ESP32_UART_ENABLED
	default n
	help
	  Adds a SECOND MCUmgr SMP transport bound to UART4 (the ESP32-C6 gateway
	  line), in addition to the USB CDC1 transport. Lets a WiFi SMP client
	  reach the device's MCUmgr server -- including the stock img group for
	  firmware OTA -- by byte-relaying through the ESP32's TCP<->UART
	  passthrough (leg 2). Reuses Zephyr's generic mcumgr serial framing; the
	  CDC1 transport and the UART4 line are unaffected when off.

	  Default n: needs the ESP32 passthrough enabled and HW validation. BLE
	  OTA is NOT available (the ESP32 app exposes no SMP/DFU BLE service); the
	  wireless OTA path is WiFi-only.

config HPI_DISPLAY_ENABLED
	bool "On-device LVGL UI (GC9503V + GT911)"
	depends on DISPLAY && LVGL
	default n
	help
	  Compile the modular Material-3 LVGL UI (app_m7/src/ui/) as an L5 bus
	  consumer + service client: live ECG/PPG waveforms, vitals, record and
	  status screens on the GC9503V panel with GT911 touch. Pure consumer --
	  nothing in core/services/transport depends on it. Default n so the image
	  is headless; enable via scripts/make_m7_disp.sh (which also applies
	  disp_conf.conf + the display overlay). The UI never runs on a producer
	  callback (deferred lv_timer update) and core/ never includes ui/.

config HPI_UI_DEBUG_CYCLE
	bool "UI debug: auto-cycle every screen"
	depends on HPI_DISPLAY_ENABLED
	default n
	help
	  Walk the UI through every screen on a timer instead of waiting for
	  touch. Exists to measure the LVGL heap high-water across the whole
	  screen set (rendering allocates well past what ui_build() reserves),
	  and to exercise the UI at all while GT911 touch is down. Debug only --
	  it takes navigation away from the user. Pair it with
	  CONFIG_SYS_HEAP_RUNTIME_STATS to get the numbers out
	  (app_m7/disp_debug.conf sets both).

config HPI_UI_DEBUG_CYCLE_MS
	int "UI debug: ms per screen"
	depends on HPI_UI_DEBUG_CYCLE
	default 3000

config HPI_EOL_SUITE_VER
	int "End-of-line (manufacturing) self-test suite version"
	default 1
	help
	  Version stamp returned by the group-64 self-test (0x0080) so the factory
	  can pin which EOL check suite a unit passed. Bump whenever the set of
	  checks or their pass criteria change. Prod pins this explicitly
	  (prj.prod.conf) so a shipped image always reports a deliberate suite
	  version. The firmware suite covers the runtime-automatable checks
	  (sd/batt/ecg/ppg/m4/qspi); SDRAM sweep, display backlight and touch are
	  bench/visual line steps (see app_m7_bench + the manufacturing checklist).

config HPI_HEALTH_POLL_MS
	int "Subsystem health monitor poll interval, ms"
	default 1000
	help
	  Period of the health monitor thread that enforces per-subsystem
	  heartbeat deadlines (DEGRADED after 1x timeout, FAILED after 2x) and
	  publishes health events. Pure software layer above the IWDG; it logs and
	  flags degradation but never resets (graceful degradation).

config HPI_WATCHDOG_TIMEOUT_MS
	int "Hardware watchdog (IWDG) timeout, ms"
	default 4000
	help
	  Window after which the IWDG resets the MCU if not fed. Per-subsystem
	  task watchdogs are layered on top of this hardware backstop.

config HPI_FS_READY_TIMEOUT_MS
	int "Max time to wait for the filesystem to become ready, ms"
	default 3000
	help
	  main() waits up to this long for fs_mount to post the FS-ready
	  semaphore. On timeout the app continues in a graceful "SD not ready"
	  state rather than crashing (independent of the legacy mount fault).

source "Kconfig.zephyr"

config HPI_RECOVERY_MODE
	bool "Reboot into MCUboot serial recovery over group-64"
	default n
	help
	  Adds group-64 command 0x00A5 (hpi/enter_recovery): set the retained
	  boot-mode flag and reboot, so MCUboot stays in serial recovery over USB
	  CDC instead of jumping to the application. This is the "device is healthy
	  but needs reflashing" entry into recovery; MCUboot's
	  CONFIG_BOOT_SERIAL_NO_APPLICATION covers the "there is no bootable image"
	  case on its own and needs nothing here.

	  Signed flavor only (prj.signed.conf). It needs RETENTION_BOOT_MODE and a
	  "zephyr,boot-mode" chosen node, both of which only the signed overlay
	  provides; asking for it without them is a build error rather than a
	  command that quietly does nothing.

config HPI_M4_UPDATE
	bool "M4 firmware update over group-64"
	default n
	select FLASH
	select FLASH_MAP
	select MBEDTLS
	select MBEDTLS_PSA_CRYPTO_C
	# Enabling the PSA crypto *library* is not enough -- each algorithm has to be
	# requested too, or psa_hash_setup() returns PSA_ERROR_NOT_SUPPORTED (-134).
	# Missing this is what made the first hardware commit fail.
	select PSA_WANT_ALG_SHA_256
	help
	  Update the M4 (algorithm core) through the M7: the host uploads an image
	  over the group-64 control channel into the QSPI staging region, the M7
	  verifies it, then erases and rewrites bank 2. A reset is needed
	  afterwards for the M4 to run it.

	  The M4 is deliberately NOT an MCUboot image -- its reset vector has 64 KB
	  granularity while MCUboot's header-size field is 16-bit, which makes the
	  two irreconcilable.

	  Requires the m4_staging_partition from the MCUboot slot map, so this is
	  only usable in the signed flavor; the service self-stubs otherwise.

if HPI_M4_UPDATE

config HPI_M4_UPDATE_REQUIRE_SIGNATURE
	bool "Require an ECDSA-P256 signature on M4 images"
	default y
	select PSA_WANT_ALG_ECDSA
	select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
	select PSA_WANT_ECC_SECP_R1_256
	help
	  Verify the uploaded M4 image's signature against the release signing key
	  (the same key MCUboot verifies the M7 against; its public half is
	  generated into the build by tools/build/gen_m4_pubkey.py).

	  Default y, and it should stay y for anything that ships. The device
	  ships with the unlock gate off, so without this check anyone with USB
	  access could put arbitrary code on the M4 while the M7 remains
	  signature-verified — an asymmetry with no justification. SHA-256 alone
	  only proves the bytes arrived intact, not who sent them.

	  Turning it off is a bench convenience (push a freshly built
	  build/m4/zephyr/zephyr.bin without signing it). A build with it off is
	  not a shippable build.

config HPI_M4_SIGNING_KEY
	string "PEM key whose public half verifies M4 images"
	default ""
	depends on HPI_M4_UPDATE_REQUIRE_SIGNATURE
	help
	  Absolute path. Empty means "use the same default as the signed build"
	  (keys/hp6_dev_ec256.pem), which is what a local developer wants.
	  Release builds pass the real key here. Relative paths are a known trap —
	  they resolve against the west topdir, not this repo.

endif # HPI_M4_UPDATE
