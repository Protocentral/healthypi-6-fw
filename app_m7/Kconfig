mainmenu "HealthyPi 6 M7"

config HPI_APP_LOG_LEVEL
	int "Compiled-in log level for this application's own modules"
	range 0 4
	default 3
	help
	  The level every HealthyPi module passes to LOG_MODULE_REGISTER
	  (0=off 1=err 2=wrn 3=inf 4=dbg). It exists because
	  CONFIG_LOG_DEFAULT_LEVEL could not do this job: every one of our
	  modules registered with a hardcoded LOG_LEVEL_INF, which OVERRIDES the
	  default, so prj.prod.conf's CONFIG_LOG_DEFAULT_LEVEL=2 trimmed nothing
	  and the shipping image logged exactly as much as a dev build. CONFIG_LOG_OVERRIDE_LEVEL cannot fix it either
	  — that only raises a floor, never lowers a ceiling.

	  Levels are compiled out, so lowering this also reclaims the flash held
	  by the dropped format strings. prj.prod.conf sets 2.

config HPI_DEV_MODE
	bool "Developer build (shell, verbose logs, dev unlock secret)"
	default n
	help
	  When enabled, compiles in the Zephyr shell (CDC 2 + UART), verbose
	  logging, and the development unlock secret. MUST be n for customer
	  builds — the production build asserts that shell/fs/log MCUmgr
	  groups are absent. See FIRMWARE_REWRITE_BUILD_PLAN.md.

config HPI_APP_BANNER
	bool "Print boot banner (version, board, build) at startup"
	default y

config HPI_HEARTBEAT_LOG
	bool "Periodic 'alive' heartbeat log (~5 s)"
	default n
	help
	  Bring-up aid that logs uptime/fs/wdt every ~5 s. Off by default
	  because it spams the dev console and buries shell echo; query status
	  on demand via `hpi sys info` / `hpi wdt` instead.

config HPI_BUS_MAX_SUBS
	int "Max sample-bus subscribers"
	default 8
	help
	  Upper bound on concurrent sample-bus consumers (UI preview,
	  recording, stream, M4 feed, diagnostics, ...). Each occupies a fixed
	  registry slot; ring storage is allocated per subscription.

config HPI_BUS_SELFTEST
	bool "Run the sample-bus self-test at boot"
	default n
	help
	  Dev aid: at boot, publish a known sequence through the sample bus and
	  verify fan-out filtering, FIFO order, payload integrity and drop
	  counting, logging a single PASS/FAIL line. Enable in dev builds; off
	  for production.

config HPI_ACQ_DEBUG
	bool "Log live ECG/PPG acquisition rates once a second"
	default n
	help
	  Dev aid: a consumer subscribes to ECG+PPG and logs frames/second per
	  channel (expect ~500/s ECG, ~125/s PPG), proving onboard acquisition
	  reaches the bus. Off for production.

config HPI_NPU_UART
	bool "NPU transport over USART2 (1 Mbaud) -- primary HealthyLink Compute link"
	default n
	depends on SERIAL
	select UART_INTERRUPT_DRIVEN
	help
	  PARKED (default n): a USART hardware issue is under investigation, so the
	  default build does not exercise the NPU UART link. The transport code is
	  complete and stays in tree; re-enable once the hardware is sorted. The NPU
	  is still detected/registered/active without it.
	  Use USART2 (host PD5/PD6/PD4/PD3 <-> module STM32N657 USART1 PB7/PB6/PA11/PB0)
	  as the command/inference transport to the HealthyLink Compute NPU, replacing
	  the parked SPI4 link. Framed
	  protocol in include/healthylink/hl_npu_uart_proto.h. When an HealthyLink Compute
	  module is detected, the app runs a STATUS + GET_INFO comms check off the boot
	  path and logs the result.

config HPI_NPU_COMMS_CHECK
	bool "Probe the HealthyLink NPU (STM32N657) over SPI4 at module start"
	default n
	depends on !HPI_NPU_UART
	help
	  Dev/bring-up aid: when an HealthyLink Compute module is detected, perform a
	  SPI4 STATUS + GET_INFO transaction with the N657 and log the link state.

	  OFF by default: SPI4 transfers are not yet proven on this hardware and a
	  faulting transceive resets the board (boot loop). The NPU is still
	  detected, registered and marked active without this; enable only for
	  focused SPI4 bring-up, ideally with a debugger/RTT attached to catch any
	  fault. The check runs on a dedicated low-priority work queue so it cannot
	  starve the watchdog, but a CPU exception in the SPI driver will still
	  reset regardless of thread.

config HPI_NPU_INFERENCE_TEST
	bool "Run one NPU inference round-trip after the comms check (bring-up)"
	default n
	depends on HPI_NPU_COMMS_CHECK
	help
	  Bring-up aid: once the SPI4 link is alive, run a full inference
	  round-trip against the HealthyLink Compute (N657) beat-classifier model --
	  LOAD_INPUT (187 INT8 ECG samples, synthetic ramp) -> RUN_INFERENCE -> wait
	  for the module IRQ (PI12) -> READ_OUTPUT (5 AAMI class scores) -- and log
	  the result. Runs once on the npu_comms work queue; dev only.

config HPI_SPI4_LOOPBACK_TEST
	bool "Run a SPI4 loopback self-test at boot (bring-up diagnostic)"
	default n
	help
	  Hardware bring-up aid for the HealthyLink slot-A SPI4 bus, which has
	  never been proven to transfer on this board (the NPU comms check faults
	  it). Externally tie SPI4 MOSI (PE6) to MISO (PE5), enable this, and the
	  app does a short conservative (1 MHz) transceive and logs whether the
	  bytes loop back (PASS) or not (FAIL/garbage).

	  Run with a debugger/RTT attached, NOT the UART-TX-only DEV flavor: if
	  SPI4 faults, the exception dump must survive the reset. The test runs on
	  a dedicated work queue so a hang cannot starve the watchdog, but a CPU
	  exception in the SPI driver will still reset. Off for normal builds.

config HPI_SECURITY
	bool "Device lock/unlock state machine"
	default n
	select MBEDTLS
	select MBEDTLS_PSA_CRYPTO_C
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_GENERATE_RANDOM
	help
	  Boot LOCKED and gate destructive / PHI / privileged MCUmgr commands
	  behind a challenge-response unlock (HMAC-SHA256 over a 16-byte CSPRNG
	  nonce, §14.4). Default n -- enable together with the MCUboot signing +
	  OTP secret provisioning (§14.5), since production needs the device-unique
	  secret in OTP. When off, hpi_security_require_unlocked() is a no-op and
	  all commands are allowed (current pre-security behavior). Enabling pulls
	  in mbedTLS PSA crypto for HMAC/SHA-256/CSPRNG -- validate the crypto +
	  entropy config on target.

if HPI_SECURITY

choice
	prompt "Unlock shared-secret source"
	default HPI_UNLOCK_SECRET_SOURCE_KCONFIG

config HPI_UNLOCK_SECRET_SOURCE_OTP
	bool "STM32H7 OTP / protected flash (production)"
	help
	  Device-unique 256-bit secret provisioned at manufacture. The OTP read is
	  not yet implemented (TODO §14.4) -- selecting this currently fails closed
	  (the device cannot be unlocked).

config HPI_UNLOCK_SECRET_SOURCE_KCONFIG
	bool "Kconfig hex string (DEVELOPMENT ONLY)"
	help
	  Dev fallback; the device logs a prominent DO-NOT-SHIP warning at boot.

endchoice

config HPI_UNLOCK_SECRET_HEX
	string "Dev unlock secret (64 hex chars = 32 bytes)"
	depends on HPI_UNLOCK_SECRET_SOURCE_KCONFIG
	default "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
	help
	  Development-only shared secret used to compute HMAC(nonce). DO NOT SHIP.

config HPI_UNLOCK_GRANT_S
	int "Unlock grant TTL, seconds"
	default 600
	range 60 3600
	help
	  How long the device stays UNLOCKED after a successful unlock_response
	  before auto-relocking (§14.4). Also relocks on hpi/lock or reboot.

endif # HPI_SECURITY

config HPI_USB_VID
	hex "USB Vendor ID (idVendor)"
	default 0x2fe3
	help
	  0x2FE3 is the Zephyr-project DEVELOPMENT VID -- not shippable. Replace
	  with a registered VID before customer shipment (for this open-source
	  product, a pid.codes PID on VID 0x1209). tools/ci/check_prod_surface.sh
	  fails a prod build that still carries the 0x2FE3 test VID.

config HPI_USB_PID
	hex "USB Product ID (idProduct)"
	default 0x0100
	help
	  Paired with HPI_USB_VID. Set to the assigned pid.codes PID for shipment.

